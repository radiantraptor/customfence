{
  "multipart": [
    {
      "apply": { "model": "customfence:block/spruce_mangrove_garden/spruce_mangrove_garden_post" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "customfence:block/spruce_mangrove_garden/spruce_mangrove_garden_side", "uvlock": true }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "customfence:block/spruce_mangrove_garden/spruce_mangrove_garden_side", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "customfence:block/spruce_mangrove_garden/spruce_mangrove_garden_side", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "customfence:block/spruce_mangrove_garden/spruce_mangrove_garden_side", "y": 270, "uvlock": true }
    }
  ]
}
